<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <PackageId>MiniStack.Testcontainers</PackageId>
        <Description>Community Testcontainers for .NET module for MiniStack, a free AWS emulator. Not affiliated with the Testcontainers project.</Description>
        <PackageTags>aws;ministack;docker;dotnet;testcontainers;testing</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Testcontainers"/>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="../../README.md" Visible="false" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
